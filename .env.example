# Docker deployment defaults (see README.md)
# For local dev without Docker, use file:./dev.db — see DEVELOPMENT.md
DATABASE_URL="file:/data/tvminder.db"

# Required: https://www.themoviedb.org/settings/api (API Read Access Token)
TMDB_API_KEY="your_tmdb_read_access_token_here"

# Recommended: protects /api/cron/refresh
CRON_SECRET="change-me-in-production"

# Optional: https://api.watchmode.com/
WATCHMODE_API_KEY=""
